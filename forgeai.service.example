# Adapt paths and create the dedicated account before installing this unit.
[Unit]
Description=ForgeAI API relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forgeai
Group=forgeai
WorkingDirectory=/opt/forgeai
ExecStart=/usr/bin/node --env-file=/opt/forgeai/.env /opt/forgeai/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/forgeai

[Install]
WantedBy=multi-user.target
