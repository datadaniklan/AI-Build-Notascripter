# AI Build by Notascripter, relay 0.3.0.
# Copy to .env on the server only. Never commit the populated file.
# Existing installations: preserve the real .env instead of copying this over it.
OPENAI_API_KEY=PASTE_YOUR_SERVER_KEY_HERE
HOST=127.0.0.1
PORT=3000
# This private file also persists submitted AI review snapshots. Protect its backups.
# Public server-chat snapshots are held separately in memory and expire after 10 minutes.
FORGE_STATE_FILE=./forgeai-quota.json
FORGE_DAILY_REQUEST_LIMIT=100
# For a local Nginx proxy that overwrites X-Real-IP:
FORGE_TRUST_LOCAL_PROXY=1
# Use only for cloudflared on this machine forwarding directly to Node:
FORGE_TRUST_CLOUDFLARE_TUNNEL=0
# Optional owner authorization. Leave empty to disable administrator endpoints.
# Use a random 32-256 character token with no whitespace. The VM update script
# generates one when absent. Never put the real value in public config or Lua.
FORGE_ADMIN_TOKEN=
